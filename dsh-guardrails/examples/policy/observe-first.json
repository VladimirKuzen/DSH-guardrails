{
  "$schema": "../../policy.schema.json",
  "version": 2,
  "enabled": true,
  "audit": { "format": "v2", "maxPayloadBytes": 65536 },
  "rules": {
    "protectDshHome": { "mode": "ask" },
    "destructive": { "mode": "ask", "dryRun": { "enabled": true } },
    "critical": { "mode": "deny", "failClosed": true },
    "secrets": { "mode": "ask" }
  },
  "entries": [
    {
      "id": "watch-package-install",
      "tool": ["pwsh"],
      "mode": "observe",
      "when": {
        "cwdUnder": ["D:\\work\\proj"],
        "commandMatches": "^\\s*(npm|pnpm)\\s+(ci|install)\\b"
      }
    }
  ]
}
